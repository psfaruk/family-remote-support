rules_version = '2';

// ============================================================
// Remote Family Support — Phase 6 rules (least privilege)
// Owner pastes this into Firebase console → Firestore → Rules.
//
// Phase 3: users/{uid} self profile + own devices.
// Phase 4: pairingInvitations + trustedDeviceRelationships.
//   - A pairing code = invitationId (6 public chars) + one-time
//     token (20 hex chars). Firestore stores ONLY the SHA-256
//     hash of the token, never the token itself.
//   - Redemption is one atomic client transaction; the rules
//     re-verify every condition server-side (including the
//     post-transaction state via getAfter()).
// Phase 5: devicePresence (heartbeat, TTL badges in the UI) +
//   fcmTokens (push registration; sending comes later).
// Phase 6: supportSessions — the explicit per-instance consent
//   grant. Helper asks (REQUESTED, 2-min deadline), recipient
//   allows (ACTIVE, 15-min sessionEndsAt) or denies, either side
//   ends early; EXPIRED/timeout are lazy cleanups. A session doc
//   grants NO data access by itself — future capabilities must
//   reference an ACTIVE session.
// Phase 7: supportSessions/{id}/signal — WebRTC signaling for live
//   screen share (offer/answer/ICE/watch/bye). Docs are addressed to
//   one reader (aud), only participants of an ACTIVE session may
//   write, and a writer may only address the OTHER participant.
// Phase 9: hardening audit — fcmTokens fields are type-checked and
//   size-bounded. Everything else survived the negative-probe suite
//   (scripts/rules-negative-probe.mjs) unchanged.
// Phase 10: Guest mode — pairingInvitations + trustedDeviceRelationships
//   + supportSessions carry a kind ('family' | 'guest'). A guest
//   relationship is a server-bounded window (guestExpiresAt, <= 3 h):
//   sessions may only be ASKED while the window is live, a granted guest
//   session can never outlive it, and guest != family is absolute — a
//   guest doc can never be re-activated through a family invitation or
//   vice versa. The only way out of a guest pair is an explicit DELETE
//   (allowed for participants on guest docs only), after which a fresh
//   family pairing may reuse the pair key. Family links stay permanent.
// Everything not matched below is denied by default.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ---------- Phase 3: profiles + registered devices ----------
    match /users/{uid} {
      allow get, list: if isSelf(uid);
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(
          ['displayName', 'email', 'photoUrl', 'createdAt', 'updatedAt']
        );
      allow delete: if false;

      match /devices/{deviceId} {
        allow get, list: if isSelf(uid);
        allow create, update: if isSelf(uid)
          && request.resource.data.keys().hasOnly(
            ['model', 'manufacturer', 'androidVersion', 'sdkInt',
             'appVersionName', 'appVersionCode', 'createdAt', 'updatedAt']
          )
          && request.resource.data.model is string
          && request.resource.data.manufacturer is string
          && request.resource.data.androidVersion is string
          && request.resource.data.sdkInt is int
          && request.resource.data.appVersionName is string
          && request.resource.data.appVersionCode is int;
        allow delete: if isSelf(uid);
      }
    }

    // ---------- Phase 4: pairing invitations ----------
    match /pairingInvitations/{invId} {
      // Reading one invitation by id is allowed for any signed-in user:
      // redeeming requires proving knowledge of the one-time token, and the
      // doc itself only holds its hash.
      allow get: if signedIn();
      // No listing — codes travel out-of-band, nobody may enumerate invites.
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
          ['inviterUid', 'inviterEmail', 'recipientDeviceId', 'recipientDeviceModel',
           'status', 'kind', 'tokenHash', 'createdAt', 'expiresAt']
        )
        && request.resource.data.inviterUid == request.auth.uid
        && request.resource.data.status == 'PENDING'
        // Phase 10: kind is optional (legacy family invites) but, when
        // present, must be one of the two pairing modes. It is frozen
        // afterwards — the update rule below never lists it.
        && (!('kind' in request.resource.data)
            || request.resource.data.kind in ['family', 'guest'])
        && request.resource.data.tokenHash is string
        && request.resource.data.tokenHash.size() == 64
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(10, 'm');

      // Out of PENDING there are exactly two doors:
      //   1) the inviter cancels their own pending invitation
      //   2) another signed-in user redeems it (PENDING -> PAIRED)
      // In both cases the token hash can never change.
      allow update: if signedIn()
        && resource.data.status == 'PENDING'
        && request.resource.data.tokenHash == resource.data.tokenHash
        && (
          (resource.data.inviterUid == request.auth.uid
            && request.resource.data.status == 'CANCELLED'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
              ['status', 'updatedAt']))
          || (resource.data.inviterUid != request.auth.uid
            && request.time < resource.data.expiresAt
            && request.resource.data.status == 'PAIRED'
            && request.resource.data.claimedBy == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
              ['status', 'claimedBy', 'claimedEmail', 'claimedAt', 'updatedAt']))
        );

      allow delete: if signedIn() && resource.data.inviterUid == request.auth.uid;
    }

    // ---------- Phase 4: trusted relationships ----------
    // Phase 10: kind 'family' (permanent) vs 'guest' (bounded window).
    match /trustedDeviceRelationships/{relId} {
      // Post-transaction state of the invitation that created this
      // relationship — lets the rules verify the atomic claim.
      function inviteAfter(relData) {
        return getAfter(/databases/$(database)/documents/pairingInvitations/$(relData.createdByInvitation)).data;
      }

      // True only when the map carries kind == 'guest' (missing kind on
      // legacy docs = family, never an error).
      function isGuestRel(d) {
        return 'kind' in d && d.kind == 'guest';
      }

      // The invitation that created the relationship must NOT be a guest
      // invite (missing kind on legacy invites = family).
      function familyInvite(inv) {
        return !('kind' in inv) || inv.kind == 'family';
      }

      // The guest window the CLIENT claims, re-bounded by the server:
      // it must be a timestamp, live now, and no more than 3 h out.
      function saneGuestWindow(d) {
        return 'guestExpiresAt' in d
          && d.guestExpiresAt is timestamp
          && d.guestExpiresAt > request.time
          && d.guestExpiresAt < request.time + duration.value(3, 'h');
      }

      // v0.6.2 fix: the redeem transaction READS the relationship doc to
      // decide create-vs-update BEFORE it exists. A get on a non-existent
      // document has no fields, so the ownership-only condition used to
      // deny it and every pairing failed with PERMISSION_DENIED. Allow the
      // read while the document is still absent — it carries no data, so
      // nothing leaks.
      allow get: if signedIn()
        && (!exists(/databases/$(database)/documents/trustedDeviceRelationships/$(relId))
            || resource.data.helperUid == request.auth.uid
            || resource.data.recipientUid == request.auth.uid);

      // Listing is only allowed when the query itself constrains the
      // results to the caller's own relationships (helperUid/recipientUid).
      allow list: if signedIn()
        && (resource.data.helperUid == request.auth.uid
            || resource.data.recipientUid == request.auth.uid);

      // Created only inside the redeem transaction: the invitation must end
      // up PAIRED with this exact helper, the recipient must be its owner,
      // and (Phase 10) the relationship kind must match the invitation kind.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
          ['helperUid', 'helperEmail', 'recipientUid', 'recipientEmail',
           'recipientDeviceId', 'recipientDeviceModel', 'pairKey', 'status',
           'createdByInvitation', 'createdAt', 'updatedAt', 'kind', 'guestExpiresAt']
        )
        && request.resource.data.helperUid == request.auth.uid
        && request.resource.data.status == 'ACTIVE'
        && request.resource.data.pairKey == (request.resource.data.helperUid + '_' + request.resource.data.recipientUid)
        && inviteAfter(request.resource.data).status == 'PAIRED'
        && inviteAfter(request.resource.data).claimedBy == request.auth.uid
        // Phase 10: the invitation must have been claimed IN THIS redeem
        // (claimedAt within 2 min) — otherwise an already-PAIRED guest
        // invitation could silently extend/refresh windows forever.
        && inviteAfter(request.resource.data).claimedAt > request.time - duration.value(2, 'm')
        && request.resource.data.recipientUid == inviteAfter(request.resource.data).inviterUid
        && (
          // family pairing — permanent link, no window
          ( !isGuestRel(request.resource.data)
            && !('guestExpiresAt' in request.resource.data)
            && familyInvite(inviteAfter(request.resource.data)) )
          ||
          // guest pairing — bounded 2 h window (client-claimed, server-bounded)
          ( isGuestRel(request.resource.data)
            && 'kind' in inviteAfter(request.resource.data)
            && inviteAfter(request.resource.data).kind == 'guest'
            && saneGuestWindow(request.resource.data) )
        );

      // After creation only status (+ guest window refresh) changes:
      //   REVOKED  — either participant, any kind
      //   EXPIRED  — lazy cleanup of an over-time GUEST link (kind frozen)
      //   ACTIVE   — re-activation through a fresh PAIRED invitation of the
      //              SAME kind (family->family: status only; guest->guest:
      //              status + a re-bounded guestExpiresAt). A guest link can
      //              never be re-activated by a family invitation and vice
      //              versa — guest != family is absolute.
      allow update: if signedIn()
        && (resource.data.helperUid == request.auth.uid
            || resource.data.recipientUid == request.auth.uid)
        && request.resource.data.status in ['ACTIVE', 'REVOKED', 'EXPIRED']
        && (
          request.resource.data.status == 'REVOKED'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          || (request.resource.data.status == 'EXPIRED'
            && isGuestRel(resource.data)
            && isGuestRel(request.resource.data)
            && resource.data.guestExpiresAt < request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
          || (request.resource.data.status == 'ACTIVE'
            && !isGuestRel(resource.data)
            && !isGuestRel(request.resource.data)
            && familyInvite(inviteAfter(request.resource.data))
            && inviteAfter(request.resource.data).status == 'PAIRED'
            && inviteAfter(request.resource.data).claimedBy == request.auth.uid
            && inviteAfter(request.resource.data).claimedAt > request.time - duration.value(2, 'm')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
          || (request.resource.data.status == 'ACTIVE'
            && isGuestRel(resource.data)
            && isGuestRel(request.resource.data)
            && 'kind' in inviteAfter(request.resource.data)
            && inviteAfter(request.resource.data).kind == 'guest'
            && inviteAfter(request.resource.data).status == 'PAIRED'
            && inviteAfter(request.resource.data).claimedBy == request.auth.uid
            && inviteAfter(request.resource.data).claimedAt > request.time - duration.value(2, 'm')
            && saneGuestWindow(request.resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
              ['status', 'guestExpiresAt', 'updatedAt']))
        );

      // Phase 10: a GUEST link may be REMOVED by either participant — the
      // documented, non-automatic path out of a guest pair (afterwards a
      // fresh family pairing may reuse the pair key). Family links are
      // permanent and can never be deleted through the client API.
      allow delete: if signedIn()
        && (resource.data.helperUid == request.auth.uid
            || resource.data.recipientUid == request.auth.uid)
        && isGuestRel(resource.data);
    }

    // ---------- Phase 5: device presence (heartbeat) ----------
    // One heartbeat doc per device: {uid}_{deviceId}. Writers may only touch
    // their own device's doc (doc id must match uid + 24-hex device id);
    // readers may read their own or a paired counterpart's (relationship doc
    // id == pairKey == helperUid_recipientUid).
    match /devicePresence/{docId} {
      function myPairing(deviceUid) {
        return exists(/databases/$(database)/documents/trustedDeviceRelationships/$(request.auth.uid + '_' + deviceUid))
          || exists(/databases/$(database)/documents/trustedDeviceRelationships/$(deviceUid + '_' + request.auth.uid));
      }

      allow get: if signedIn()
        && (resource.data.uid == request.auth.uid || myPairing(resource.data.uid));
      allow list: if signedIn()
        && (resource.data.uid == request.auth.uid || myPairing(resource.data.uid));

      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && docId.matches(request.auth.uid + '_[0-9a-f]{24}')
        && request.resource.data.keys().hasOnly(
          ['uid', 'deviceId', 'model', 'heartbeatAt', 'updatedAt']
        )
        && request.resource.data.uid is string
        && request.resource.data.deviceId is string
        && request.resource.data.model is string;

      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ---------- Phase 5: FCM token registry ----------
    // Push registration only — sending notifications is a server-side concern
    // in a later phase. Tokens are strictly private to their owner.
    // v0.10.0 (Phase 9): type-checked fields + an upper size bound — a real
    // FCM token is 100–200 chars; 4096 keeps hostile writes out without
    // ever rejecting a legitimate refresh.
    match /fcmTokens/{tokenId} {
      allow get, list: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'deviceId', 'token', 'updatedAt'])
        && request.resource.data.uid is string
        && request.resource.data.deviceId is string
        && request.resource.data.token is string
        && request.resource.data.token.size() >= 32
        && request.resource.data.token.size() <= 4096;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ---------- Phase 6: support sessions (explicit consent) ----------
    // Lifecycle (client transactions + these server-side re-checks):
    //   REQUESTED -> ACTIVE   recipient only, within the 2-min deadline,
    //                         sessionEndsAt <= request.time + 20 min
    //   REQUESTED -> DENIED   recipient only
    //   REQUESTED -> CANCELLED helper only
    //   REQUESTED -> EXPIRED  either participant (lazy cleanup)
    //   ACTIVE    -> ENDED    either participant (endedBy = uid or "timeout")
    // Nothing else is possible; deletes are impossible.
    // Phase 10: sessions carry kind ('family' | 'guest', absent = family on
    //   legacy docs). kind must match the relationship's kind, a guest rel
    //   only authorizes asks while guestExpiresAt is live, and a granted
    //   guest session's sessionEndsAt can never pass that window.
    match /supportSessions/{sessionId} {
      function isSessionParticipant() {
        return resource.data.helperUid == request.auth.uid
          || resource.data.recipientUid == request.auth.uid;
      }

      // The relationship the ask is riding on (create-time check).
      function relNow() {
        return get(/databases/$(database)/documents/trustedDeviceRelationships/$(request.resource.data.relId)).data;
      }

      allow get: if signedIn() && isSessionParticipant();
      allow list: if signedIn() && isSessionParticipant();

      // Only the helper of an ACTIVE relationship may ask, only for that
      // relationship, and only with a sane (0 < deadline <= 5 min) deadline.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
          ['relId', 'helperUid', 'helperEmail', 'recipientUid', 'recipientEmail',
           'recipientDeviceModel', 'status', 'kind', 'requestedAt', 'respondDeadline',
           'createdAt', 'updatedAt']
        )
        && request.resource.data.helperUid == request.auth.uid
        && request.resource.data.status == 'REQUESTED'
        && request.resource.data.relId is string
        && request.resource.data.helperEmail is string
        && request.resource.data.recipientEmail is string
        && request.resource.data.recipientDeviceModel is string
        // Phase 10: kind is optional (legacy family clients) but, when
        // present, must be one of the two modes and must MATCH the rel.
        && (!('kind' in request.resource.data)
            || request.resource.data.kind in ['family', 'guest'])
        && request.resource.data.relId == (request.resource.data.helperUid + '_' + request.resource.data.recipientUid)
        && exists(/databases/$(database)/documents/trustedDeviceRelationships/$(request.resource.data.relId))
        && relNow().status == 'ACTIVE'
        && (
          // family rel — only family/legacy asks, any time
          ( !('kind' in relNow()) || relNow().kind == 'family' )
            ? ( !('kind' in request.resource.data)
                || request.resource.data.kind == 'family' )
          // guest rel — only guest asks, and only inside the live window
            : ( relNow().kind == 'guest'
                && 'guestExpiresAt' in relNow()
                && relNow().guestExpiresAt > request.time
                && request.resource.data.kind == 'guest' )
        )
        && request.resource.data.respondDeadline is timestamp
        && request.resource.data.respondDeadline > request.time
        && request.resource.data.respondDeadline < request.time + duration.value(5, 'm');

      allow update: if signedIn() && isSessionParticipant()
        && request.resource.data.status in ['ACTIVE', 'DENIED', 'CANCELLED', 'EXPIRED', 'ENDED']
        && (
          // recipient grants within the deadline
          (resource.data.status == 'REQUESTED'
            && request.resource.data.status == 'ACTIVE'
            && resource.data.recipientUid == request.auth.uid
            && request.time < resource.data.respondDeadline
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
              ['status', 'respondedAt', 'grantedAt', 'sessionEndsAt', 'updatedAt'])
            && request.resource.data.sessionEndsAt is timestamp
            && request.resource.data.sessionEndsAt > request.time
            && request.resource.data.sessionEndsAt < request.time + duration.value(20, 'm')
            // Phase 10: a GUEST session can never outlive its guest link's
            // window (family/legacy sessions skip this extra cap).
            && (!('kind' in resource.data) || resource.data.kind != 'guest'
                || get(/databases/$(database)/documents/trustedDeviceRelationships/$(resource.data.relId)).data.guestExpiresAt
                    >= request.resource.data.sessionEndsAt))
          // recipient denies
          || (resource.data.status == 'REQUESTED'
            && request.resource.data.status == 'DENIED'
            && resource.data.recipientUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
              ['status', 'respondedAt', 'updatedAt']))
          // helper cancels their own ask
          || (resource.data.status == 'REQUESTED'
            && request.resource.data.status == 'CANCELLED'
            && resource.data.helperUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
              ['status', 'respondedAt', 'updatedAt']))
          // lazy expiry of a stale ask (either participant)
          || (resource.data.status == 'REQUESTED'
            && request.resource.data.status == 'EXPIRED'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
              ['status', 'updatedAt']))
          // either side ends an active session (or the auto-timeout does)
          || (resource.data.status == 'ACTIVE'
            && request.resource.data.status == 'ENDED'
            && request.resource.data.endedBy in [request.auth.uid, 'timeout']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
              ['status', 'endedAt', 'endedBy', 'updatedAt']))
        );

      allow delete: if false;

      // ---------- Phase 7: WebRTC signaling (screen share) ----------
      // Short-lived docs: {aud, from, type: offer|answer|ice|watch|bye,
      // cmd, cmdack — Phase 8 remote assist, payload, ep, createdAt}.
      // aud = the INTENDED READER, so every side only
      // ever lists documents addressed to it; the writer can only address
      // the other participant, and only while the session is ACTIVE.
      // v0.8.1: "ep" is a per-round epoch token both apps use to ignore stale
      // documents from an earlier negotiation round. It carries no authority
      // (the reader's own epoch filter does the work), so the rules only
      // require it to be a short string.
      // v0.9.0 (Phase 8): "cmd"/"cmdack" carry remote-assist taps/nav — same
      // queue, same epoch gate; commands only ever execute on the recipient
      // while its owner enabled the assist accessibility service, and only
      // while the session is ACTIVE (enforced again client-side by the
      // engine).
      match /signal/{sigId} {
        function sessionNow() {
          return get(/databases/$(database)/documents/supportSessions/$(sessionId)).data;
        }

        allow get, list: if signedIn()
          && resource.data.aud == request.auth.uid;

        allow create: if signedIn()
          && sessionNow().status == 'ACTIVE'
          && (sessionNow().helperUid == request.auth.uid
              || sessionNow().recipientUid == request.auth.uid)
          && request.resource.data.from == request.auth.uid
          && request.resource.data.aud == (sessionNow().helperUid == request.auth.uid
              ? sessionNow().recipientUid : sessionNow().helperUid)
          && request.resource.data.keys().hasOnly(
            ['aud', 'from', 'type', 'payload', 'ep', 'createdAt'])
          && request.resource.data.type in
            ['offer', 'answer', 'ice', 'watch', 'bye', 'cmd', 'cmdack']
          && request.resource.data.payload is string
          && request.resource.data.payload.size() < 100000
          && request.resource.data.ep is string
          && request.resource.data.ep.size() <= 64;

        allow update: if false;

        // Either participant may clean up the queue (best-effort wipes).
        allow delete: if signedIn()
          && (sessionNow().helperUid == request.auth.uid
              || sessionNow().recipientUid == request.auth.uid);
      }
    }

    // ---------- Phase 7.2 (v0.8.3): runtime app config ----------
    // config/turn holds optional TURN relay credentials the app reads at
    // session start. Apps may READ only; writes happen exclusively through
    // the Owner's service account (the Admin SDK bypasses these rules), so
    // relay credentials can be rotated without ever shipping a new APK.
    match /config/{docId} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Catch-all: deny everything not matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
