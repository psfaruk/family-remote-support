<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Phase 5: QR pairing-code scan (CameraX + ML Kit). Runtime prompt happens
         in the scan dialog; the app works fully without it (code typing). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- v0.6.1: saving the pairing QR into the public Download folder on
         Android 8–9 only. Android 10+ uses MediaStore (no permission). -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- Phase 6: lets the recipient see a support-session request while the
         app is backgrounded. Runtime prompt happens in the session section. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Phase 7: live screen share (MediaProjection). The projection consent
         dialog is the only user gate; the foreground service keeps Android
         from killing the capture mid-session. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FamilyRemoteSupport">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Phase 7: keeps the screen capture alive; mediaProjection is a
             required declared type on Android 14+ (the engine touches the
             MediaProjection only AFTER startForeground, as required). -->
        <service
            android:name=".ScreenShareService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Phase 8 (v0.9.0): REMOTE ASSIST. The grantor enables this ONCE in
             system Settings → Accessibility; without it the helper stays
             view-only (Phase 7 behaviour). canRetrieveWindowContent=false in
             res/xml/assist_service_config.xml — the service performs taps
             ONLY, it reads nothing from the screen. Commands reach it only
             through the ACTIVE-session signal queue (same epoch chain as the
             video). -->
        <service
            android:name=".AssistService"
            android:exported="false"
            android:label="@string/assist_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/assist_service_config" />
        </service>

        <!-- v0.6.1: lets the share sheet receive the QR PNG staged in the
             app cache without exposing any other file. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
